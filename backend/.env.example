# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on. The dashboard's VITE_API_TARGET must match it.
PORT=5000

# MongoDB connection string, e.g. from Atlas: Connect -> Drivers -> Node.js.
# Replace <db_password> and remove the angle brackets.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/healthnova?retryWrites=true&w=majority

# Any long random string. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Where the Python prediction service runs (ml_service).
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional: comma-separated origins allowed to call the API from a browser.
# Leave empty to allow any origin (needed for Flutter web during development).
CORS_ORIGIN=
